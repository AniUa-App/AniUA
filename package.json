{
  "name": "aniua",
  "version": "0.0.2",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "npm run set-env && ORG_GRADLE_PROJECT_reactNativeArchitectures=armeabi-v7a,arm64-v8a,x86,x86_64 expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "setup-file-opener": "node scripts/setup-file-opener-v3.js",
    "setup-ffmpeg": "cd android && ./gradlew downloadAar && cd ..",
    "eas-build-pre-install": "npm config set legacy-peer-deps true",
    "eas-build-post-install": "npx patch-package && npm run setup-ffmpeg",
    "postinstall": "patch-package",
    "prebuild": "npx expo prebuild --clean --platform android && npm run setup-file-opener && npx patch-package && npm run setup-ffmpeg",
    "set-env": "node ./scripts/set-environment.js",
    "update-release": "npm run set-env && node scripts/update-release.js",
    "build-release": "npm run prebuild && npm run set-env && npx eas build --platform android --profile release --local",
    "build-release-apk": "SPLIT_APKS=true npm run prebuild && npm run set-env && (npx eas build --platform android --profile release-apk --local || ls build-*.tar.gz > /dev/null 2>&1)"
  },
  "dependencies": {
    "@expensify/react-native-live-markdown": "^0.1.322",
    "@gorhom/bottom-sheet": "^5.1.8",
    "@notifee/react-native": "^9.1.8",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "^5.1.2",
    "@react-native-firebase/analytics": "^23.8.6",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-navigation/bottom-tabs": "^7.4.4",
    "@react-navigation/material-top-tabs": "^7.3.4",
    "@react-navigation/native": "^7.1.16",
    "@react-navigation/native-stack": "^7.3.23",
    "@react-navigation/stack": "^7.4.4",
    "@shopify/react-native-skia": "2.2.12",
    "axios": "^1.11.0",
    "color": "^5.0.0",
    "date-fns": "^4.1.0",
    "expensify-common": "^2.0.171",
    "expo": "^54.0.0",
    "expo-application": "~7.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-media-library": "~18.2.1",
    "expo-navigation-bar": "~5.0.10",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-screen-orientation": "~9.0.8",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "ffmpeg-kit-react-native": "^6.0.2",
    "html-entities": "^2.5.3",
    "m3u8-file-parser": "^0.2.4",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "pako": "^2.1.0",
    "patch-package": "^8.0.0",
    "phosphor-react-native": "^3.0.0",
    "react": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81.5-2",
    "react-native-awesome-slider": "^2.9.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-file-opener": "./react-native-file-opener",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-orientation-locker": "^1.7.0",
    "react-native-pager-view": "6.9.1",
    "react-native-qrcode-styled": "^0.4.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-root-siblings": "^5.0.1",
    "react-native-root-toast": "^4.0.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-selectable-text-input": "./react-native-selectable-text-input",
    "react-native-shadow-2": "^7.1.2",
    "react-native-svg": "15.12.1",
    "react-native-system-navigation-bar": "^2.6.4",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-vision-camera": "^4.7.3",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-zeroconf": "^0.14.0",
    "reanimated-color-picker": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/config-plugins": "~54.0.4",
    "@react-native-tvos/config-tv": "^0.1.5",
    "@types/pako": "^2.0.4",
    "dotenv": "^17.3.1",
    "react-native-svg-transformer": "^1.5.1",
    "reactotron-apisauce": "^3.0.6",
    "reactotron-react-native": "^5.1.14",
    "reactotron-react-native-mmkv": "^0.2.8",
    "typescript": "~5.9"
  },
  "overrides": {
    "html-entities": "2.5.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native",
        "@react-native-community/netinfo",
        "@react-native-community/slider"
      ]
    }
  },
  "private": true
}
